transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {C:/vhdl/cronometro-digital/cronometro.vhd}
vcom -93 -work work {C:/vhdl/cronometro-digital/debouncer.vhd}
vcom -93 -work work {C:/vhdl/cronometro-digital/cont16_ld.vhd}

vcom -93 -work work {C:/vhdl/cronometro-digital/cronometro_tb.vhd}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L cyclone10lp -L rtl_work -L work -voptargs="+acc"  cronometro_tb

add wave *
view structure
view signals
run -all
